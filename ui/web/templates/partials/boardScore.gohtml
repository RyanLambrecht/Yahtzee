{{define "boardScore" -}}
<div id="board">
	{{template "currentPlayer" .}}
	{{template "cardScore" .}}
	{{template "displayRoll" (index .Players .CurrentPlayerIndex)}}
</div>
{{- end}}

{{define "cardScore" -}}
<div id="cardScore">
	<table>
		{{template "cardHead" .}}
		<tbody class="cardUpper">
			{{range $cat := .UpperSection}}
			<tr>
				<th>{{$cat.Name}}</th>
				{{range $i, $player := $.Players}}
				{{$pts := index $player.PointsByCategory $cat.Index}}
				<td>
					{{if and (eq $i $.CurrentPlayerIndex) (eq $pts $.UnusedSlot)}}
					<button hx-post="/score/{{$cat.Index}}" hx-target="#board" hx-swap="outerHTML">Score</button>
					{{else}}{{$pts}}{{end}}
				</td>
				{{end}}
			</tr>
			{{end}}
		</tbody>
		{{template "bonus" .}}
		<tbody class="cardLower">
			{{range $cat := .LowerSection}}
			<tr>
				<th>{{$cat.Name}}</th>
				{{range $i, $player := $.Players}}
				{{$pts := index $player.PointsByCategory $cat.Index}}
				<td>
					{{if and (eq $i $.CurrentPlayerIndex) (eq $pts $.UnusedSlot)}}
					<button hx-post="/score/{{$cat.Index}}" hx-target="#board" hx-swap="outerHTML">Score</button>
					{{else}}{{$pts}}{{end}}
				</td>
				{{end}}
			</tr>
			{{end}}
		</tbody>
		{{template "cardFoot" .}}
	</table>
</div>
{{- end }}

{{define "displayRoll" -}}
<div id="displayRoll">
	{{range .Dice}}<span class="die">{{.}}</span>{{end}}
</div>
{{- end}}
