{{define "boardScore" -}}
<div id="board">
	{{template "currentPlayer" .}}
	{{template "cardScore" .}}
	{{template "displayRoll" (index .Players .CurrentPlayerIndex)}}
</div>
{{- end}}


{{define "cardScore" -}}
<div id="cardScore">
	<table>
		{{template "cardHead" .}}
		<tbody class="cardUpper">
			{{range $cat := .UpperSection}}
			<tr>
				<th>{{$cat.Name}}</th>
				{{range $i, $player := $.Players}}
				{{$pts := index $player.PointsByCategory $cat.Index}}
				{{$slotUnused := eq $pts $.UnusedSlot}}
				{{$currPlayer := eq $i $.CurrentPlayerIndex}}
				<td {{if and $slotUnused $currPlayer}}class="scoreChoice" {{end}}>
					{{if $slotUnused}}
					{{if $currPlayer}}
					<button class="scoreCellButton" aria-label="Score {{$cat.Name}}" hx-post="/score/{{$cat.Index}}"
						hx-target="#board" hx-swap="outerHTML">
					</button>
					{{end}}
					{{else}}
					{{$pts}}
					{{end}}
				</td>
				{{end}}
			</tr>
			{{end}}
		</tbody>
		{{template "bonus" .}}
		<tbody class="cardLower">
			{{range $cat := .LowerSection}}
			<tr>
				<th>{{$cat.Name}}</th>
				{{range $i, $player := $.Players}}
				{{$pts := index $player.PointsByCategory $cat.Index}}
				{{$slotUnused := eq $pts $.UnusedSlot}}
				{{$currPlayer := eq $i $.CurrentPlayerIndex}}
				<td {{if and $slotUnused $currPlayer}}class="scoreChoice" {{end}}>
					{{if $slotUnused}}
					{{if $currPlayer}}
					<button class="scoreCellButton" aria-label="Score {{$cat.Name}}" hx-post="/score/{{$cat.Index}}"
						hx-target="#board" hx-swap="outerHTML">
					</button>
					{{end}}
					{{else}}
					{{$pts}}
					{{end}}
				</td>
				{{end}}
			</tr>
			{{end}}
		</tbody>
		{{template "cardFoot" .}}
	</table>
</div>
{{- end}}


{{define "displayRoll" -}}
<div id="displayRoll" class="label dice-row">
	{{range .Dice}}<span class="die"><img src="/static/dice/custom/j{{.}}.PNG" alt="Die showing {{.}}"></span>{{end}}
</div>
{{- end}}
