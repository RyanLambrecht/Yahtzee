{{define "board"}}
<div class="board">
	<div id="board-content">
		{{template "gameCard" .}}
	</div>
	{{template "startRoll" .}}
</div>
{{end}}

{{define "gameCard" -}}
<div class="card">
	{{if .Players}}<h2>{{(index .Players .CurrentPlayerIndex).Name}}</h2>{{end}}
	<table>
		<thead class="cardHeader">
			<tr>
				<th>Category</th>
				{{range $_, $player := .Players}}<th>{{$player.Name}}</th>{{end}}
			</tr>
		</thead>
		<tbody class="cardUpper">
			{{range $cat := .UpperSection}}
			<tr>
				<th>{{$cat.Name}}</th>
				{{range $_, $player := $.Players}}
				<td>{{index $player.PointsByCategory $cat.Index}}</td>
				{{end}}
			</tr>
			{{end}}
		</tbody>
		<tbody class="cardBonus">
			<tr>
				<th>Bonus</th>
				{{range $_, $player := .Players}}<td>{{$player.Bonus}}</td>{{end}}
			</tr>
		</tbody>
		<tbody class="cardLower">
			{{range $cat := .LowerSection}}
			<tr>
				<th>{{$cat.Name}}</th>
				{{range $_, $player := $.Players}}
				<td>{{index $player.PointsByCategory $cat.Index}}</td>
				{{end}}
			</tr>
			{{end}}
		</tbody>
		<tfoot class="cardTotal">
			<tr>
				<th>Total</th>
				{{range $_, $player := .Players}}<td>{{$player.TotalPoints}}</td>{{end}}
			</tr>
		</tfoot>
	</table>
</div>
{{end -}}


