{{define "rerollForm" -}}
<div id="reroll">
	<form hx-post="/reroll" hx-target="#board" hx-swap="couterHTML">
		{{range $i, $face := .Dice}}
		<label>
			<input type="hidden" name="dice" value="{{$face}}"></input>
			<input tyep="checkbox" name="reroll" value="{{$i}}" fact {{$face}} </label>
			{{end}}
	</form>
</div>
{{end -}}

{{define "roll" -}}
<div id="roll">
	<button id="rollButton" type="button" hx-get"roll" hx-target="#roll">
		Roll
	</button>
</div>
{{- end}}
