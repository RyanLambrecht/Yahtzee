{{define "boardPlay" -}}
<div id="board">
	{{template "currentPlayer" .}}
	{{template "cardScore" .}}
	{{template "startRoll" }}
</div>
{{- end}}



{{define "startRoll" -}}
<button id="startRoll" type="button" hx-get="/roll" hx-target="#startRoll" hx-swap="outerHTML">Roll</button>
{{- end}}

{{define "rerollDice" -}}
<div id="reroll">
	<form hx-post="/reroll" hx-target="#reroll" hx-swap="outerHTML">
		{{range $i, $face := .Dice}}
		<input type="hidden" name="dice" value="{{$face}}">
		<label class="label die">
			<input type="checkbox" name="reroll" value="{{$i}}">
			<!-- {{$face}} -->
			<img src="/static/dice/custom/j{{$face}}.PNG" alt="Die showing {{$face}}">
		</label>
		{{end}}
		<button id="reroll-button" type="submit">Reroll selected</button>
	</form>
</div>
{{- end}}
