{{define "boardPlay" -}}
<div id="board">
	{{template "currentPlayer" .}}
	{{template "cardScore" .}}
	{{template "startRoll" }}
</div>
{{- end}}



{{define "startRoll" -}}
<button id="startRoll" class="wide-button" type="button" data-key=" " hx-get="/roll" hx-target="#startRoll"
	hx-swap="outerHTML">Roll</button>
{{- end}}

{{define "rerollDice" -}}
<div id="reroll">
	<form hx-post="/reroll" hx-target="#reroll" hx-swap="outerHTML">
		{{range $i, $face := .Dice}}
		<input type="hidden" name="dice" value="{{$face}}">
		<label class="label die" data-key="{{inc $i}}">
			<input type="checkbox" name="reroll" value="{{$i}}">
			<img src="/static/dice/custom/j{{$face}}.PNG" alt="Die showing {{$face}}">
			<kbd>{{inc $i}}</kbd>
		</label>
		{{end}}
		<button id="reroll-button" class="wide-button" type="submit" data-key=" ">Reroll</button>
	</form>
</div>
{{- end}}
